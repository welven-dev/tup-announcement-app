rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOfficer() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ['admin', 'department_head', 'org_officer'];
    }

    match /announcements/{id} {
      allow read: if true;
      allow create: if isOfficer() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isOfficer() && resource.data.createdBy == request.auth.uid;
    }

    match /handbook/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}